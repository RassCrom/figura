{
  "name": "guess-the-figure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-figures.mjs",
    "check:data": "node scripts/prepare-figures.mjs --check",
    "predev": "pnpm run prepare:data",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prebuild": "pnpm run prepare:data",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "ci": "pnpm run check:data && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@turf/great-circle": "^7.2.0",
    "@vercel/analytics": "^2.0.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@9.15.9"
}
